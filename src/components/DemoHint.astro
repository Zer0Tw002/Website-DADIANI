---
// Пометка демо-версии «Здесь будет ваш…» (пунктирная плашка с карандашом).
// Показывается только при DEMO = true (src/config/status.ts), иначе ничего не выводит.
// tone: light — на светлом фоне (крем), dark — на винном фоне.
import { DEMO } from '../config/status';

interface Props {
  text: string;
  tone?: 'light' | 'dark';
  class?: string;
}

const { text, tone = 'light', class: className } = Astro.props;
---

{
  DEMO && (
    <p
      role="note"
      class:list={[
        'inline-flex w-fit items-start gap-2 rounded-lg border border-dashed px-3 py-1.5 text-sm font-semibold',
        tone === 'dark' ? 'border-coral/70 text-coral' : 'border-pomegranate-dark/50 bg-white/60 text-pomegranate-dark',
        className,
      ]}
    >
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="mt-0.5 shrink-0"
      >
        <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path>
      </svg>
      <span>{text}</span>
    </p>
  )
}
