---
// Подвал: адрес, режим работы, контакты и строка ссылок (Яндекс.Еда · Wolt · 2ГИС · Instagram).
// Все данные — из src/config/site.ts; показываются только заполненные ссылки.
// compact — короткий вариант (на главной и «О нас», где адрес и часы уже есть в отдельном блоке).
import Hours from './Hours.astro';
import { developer, isFilled, phoneHref, site, whatsappLink } from '../config/site';
import { DEMO, IS_CONCEPT } from '../config/status';
import { deliveryLinks } from '../lib/links';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const link = 'text-coral underline-offset-4 hover:underline';
const heading = 'font-display text-xs tracking-[0.16em] text-rose-ash uppercase';

const links = [
  ...deliveryLinks(lang),
  { url: site.map2gis, label: t('link.2gis') },
  { url: site.instagram, label: 'Instagram' },
].filter((l) => isFilled(l.url));
---

<footer id="contacts" class="bg-wine text-cream">
  {
    IS_CONCEPT && (
      <div class="mx-auto max-w-5xl px-4 pt-8">
        <p role="note" class="rounded-lg border-2 border-coral px-4 py-3 text-center font-semibold text-coral">
          {t('concept.notice')}
        </p>
      </div>
    )
  }
  {
    DEMO && (
      <div class="mx-auto max-w-5xl px-4 pt-8">
        <div class="flex flex-col gap-4 rounded-2xl border-2 border-dashed border-coral/70 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
          <div>
            <p class="font-display text-xl font-light tracking-[0.12em] text-coral uppercase">{t('demo.footerTitle')}</p>
            <p class="mt-2 max-w-xl text-blush">{t('demo.footerText')}</p>
          </div>
          <a
            href={whatsappLink(t('demo.message'), developer.whatsapp)}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-xl bg-coral px-6 py-3 text-center font-semibold text-wine hover:bg-blush focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral"
          >
            {t('demo.cta')}
          </a>
        </div>
      </div>
    )
  }
  {
    compact ? (
      <div class="mx-auto flex max-w-5xl flex-col items-center gap-1 px-4 pt-6 text-center text-sm sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-3">
        {/* На узких экранах адрес и часы — двумя строками, на широких — одной строкой через точку */}
        <p class="flex flex-col sm:block">
          <span>{site.address[lang]}</span>
          <span aria-hidden="true" class="hidden text-rose-ash sm:inline"> · </span>
          <span>
            <Hours text={site.hours[lang]} />
          </span>
        </p>
        {isFilled(site.phone) && (
          <>
            <span aria-hidden="true" class="hidden text-rose-ash sm:inline">·</span>
            <p>
              <a href={phoneHref(site.phone)} class="whitespace-nowrap hover:underline">
                {site.phone}
              </a>
            </p>
          </>
        )}
      </div>
    ) : (
      <div class="mx-auto grid max-w-5xl gap-6 px-4 pt-8 sm:grid-cols-3">
        <div>
          <h2 class={heading}>{t('footer.address')}</h2>
          <p class="mt-2">{site.address[lang]}</p>
        </div>
        <div>
          <h2 class={heading}>{t('footer.hours')}</h2>
          <p class="mt-2">
            <Hours text={site.hours[lang]} />
          </p>
          {site.serviceFee > 0 && <p class="mt-1 text-blush">{t('service.fee').replace('{n}', String(site.serviceFee))}</p>}
        </div>
        <div>
          <h2 class={heading}>{t('footer.contacts')}</h2>
          <ul class="mt-2 grid gap-1">
            {isFilled(site.phone) && (
              <li>
                <a href={phoneHref(site.phone)} class="whitespace-nowrap hover:underline">
                  {site.phone}
                </a>
              </li>
            )}
            <li>
              <a href={whatsappLink(t('whatsapp.message'))} class={link} target="_blank" rel="noopener">
                {t('footer.whatsapp')}
              </a>
            </li>
          </ul>
        </div>
      </div>
    )
  }
  {
    links.length > 0 && (
      <nav aria-label={t('footer.links')} class="mx-auto max-w-5xl px-4 pt-4 pb-6">
        <ul class:list={['flex flex-wrap items-center gap-x-3 gap-y-1 text-sm', compact ? 'justify-center' : 'sm:justify-start']}>
          {links.map((l, i) => (
            <li class="flex items-center gap-x-3">
              {i > 0 && (
                <span aria-hidden="true" class="text-rose-ash">
                  ·
                </span>
              )}
              <a href={l.url} class={link} target="_blank" rel="noopener">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <p class="border-t border-white/10 px-4 py-4 text-center text-xs text-rose-ash">© {year} {site.name[lang]}</p>
</footer>
