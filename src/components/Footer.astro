---
// Подвал: адрес, режим работы, контакты. Все данные — из src/config/site.ts.
import { isFilled, phoneHref, site, whatsappLink } from '../config/site';
import { IS_CONCEPT } from '../config/status';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const link = 'text-coral underline-offset-4 hover:underline';
---

<footer class="bg-wine text-cream">
  {
    IS_CONCEPT && (
      <div class="mx-auto max-w-5xl px-4 pt-8">
        <p role="note" class="rounded-lg border-2 border-coral px-4 py-3 text-center font-semibold text-coral">
          {t('concept.notice')}
        </p>
      </div>
    )
  }
  <div class="mx-auto grid max-w-5xl gap-6 px-4 py-8 sm:grid-cols-3">
    <div>
      <h2 class="font-display text-xs tracking-[0.16em] text-rose-ash uppercase">{t('footer.address')}</h2>
      <p class="mt-2">{site.address[lang]}</p>
      {
        isFilled(site.map2gis) && (
          <a href={site.map2gis} class:list={['mt-1 inline-block', link]} target="_blank" rel="noopener">
            {t('footer.route')}
          </a>
        )
      }
    </div>
    <div>
      <h2 class="font-display text-xs tracking-[0.16em] text-rose-ash uppercase">{t('footer.hours')}</h2>
      <p class="mt-2">{site.hours[lang]}</p>
    </div>
    <div>
      <h2 class="font-display text-xs tracking-[0.16em] text-rose-ash uppercase">{t('footer.contacts')}</h2>
      <ul class="mt-2 grid gap-1">
        {
          isFilled(site.phone) && (
            <li>
              <a href={phoneHref(site.phone)} class="whitespace-nowrap hover:underline">
                {site.phone}
              </a>
            </li>
          )
        }
        <li>
          <a href={whatsappLink(t('whatsapp.message'))} class={link} target="_blank" rel="noopener">
            {t('footer.whatsapp')}
          </a>
        </li>
        {
          isFilled(site.instagram) && (
            <li>
              <a href={site.instagram} class={link} target="_blank" rel="noopener">
                Instagram
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
  <p class="border-t border-white/10 px-4 py-4 text-center text-xs text-rose-ash">© {year} {site.name}</p>
</footer>
