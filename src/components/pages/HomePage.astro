---
// Главная страница (общая для всех языков).
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingForm from '../BookingForm.astro';
import DeliveryBlock from '../home/DeliveryBlock.astro';
import HomeHero from '../home/HomeHero.astro';
import PopularDishes from '../home/PopularDishes.astro';
import Promotions from '../home/Promotions.astro';
import VisitInfo from '../home/VisitInfo.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<BaseLayout lang={lang} route="home" compactFooter>
  <HomeHero lang={lang} />
  <div class="mx-auto grid max-w-5xl grid-cols-1 gap-14 px-4 py-12 sm:gap-16 sm:py-16">
    <PopularDishes lang={lang} />
    <Promotions lang={lang} />
    <BookingForm lang={lang} />
    <DeliveryBlock lang={lang} />
    <VisitInfo lang={lang} />
  </div>
</BaseLayout>
