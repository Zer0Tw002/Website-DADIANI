---
// Главная страница (общая для всех языков). Полное наполнение — этап 7.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingForm from '../BookingForm.astro';
import ContactActions from '../ContactActions.astro';
import { site } from '../../config/site';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} route="home">
  <div class="mx-auto grid max-w-5xl gap-10 px-4 py-10 sm:py-12">
    <section class="grid gap-6">
      <div>
        <h1 class="font-display text-3xl font-light tracking-[0.16em] uppercase">{site.name}</h1>
        <p class="mt-2 text-rose-ash-dark">{t('tagline')}</p>
      </div>
      <ContactActions lang={lang} />
    </section>

    <BookingForm lang={lang} />

    <p class="text-rose-ash-dark">[TODO: остальное наполнение главной — этап 7]</p>
  </div>
</BaseLayout>
