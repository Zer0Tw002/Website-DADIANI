---
// Страница 404 (общая для всех языков). Cloudflare Pages показывает ближайший 404.html:
// /kk/… → /kk/404.html, /en/… → /en/404.html, остальное → /404.html (русский).
import BaseLayout from '../../layouts/BaseLayout.astro';
import LogoOrnament from '../home/LogoOrnament.astro';
import { pathFor, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const btn =
  'inline-flex min-h-12 items-center justify-center rounded-xl px-6 py-3 text-center font-semibold focus-visible:outline-2 focus-visible:outline-offset-2';
---

<BaseLayout lang={lang} route="home" title={t('404.title')} notFound>
  <section class="relative overflow-hidden bg-wine text-cream" aria-labelledby="nf-title">
    <LogoOrnament
      class="pointer-events-none absolute top-1/2 -right-24 hidden size-[26rem] -translate-y-1/2 text-blush opacity-[0.07] md:block"
    />
    <div class="relative mx-auto max-w-5xl px-4 py-16 sm:py-24">
      <p class="font-display text-6xl font-light tracking-[0.18em] text-coral sm:text-8xl">404</p>
      <h1 id="nf-title" class="mt-4 font-display text-2xl font-light tracking-[0.12em] uppercase sm:text-3xl">
        {t('404.title')}
      </h1>
      <p class="mt-4 max-w-xl text-lg text-balance text-blush">{t('404.text')}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={pathFor(lang, 'home')} class:list={[btn, 'bg-coral text-wine hover:bg-blush focus-visible:outline-coral']}>
          {t('404.home')}
        </a>
        <a
          href={pathFor(lang, 'menu')}
          class:list={[btn, 'border-2 border-blush/60 text-cream hover:border-cream focus-visible:outline-coral']}
        >
          {t('nav.menu')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
