---
// Контурный орнамент для фона: круги и вложенные ромбы тонкими линиями одного цвета.
// Цвет берётся из currentColor, прозрачность задаёт тот, кто вставляет компонент.
// Для сайта клиента орнамент можно сделать по мотивам его логотипа.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="-72 -72 144 144"
  fill="none"
  stroke="currentColor"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <g stroke-width="1.2">
    <circle r="67" vector-effect="non-scaling-stroke"></circle>
    <circle r="61" vector-effect="non-scaling-stroke"></circle>
    <path d="M0,-56 L56,0 L0,56 L-56,0 Z" vector-effect="non-scaling-stroke"></path>
    <path d="M0,-40 L40,0 L0,40 L-40,0 Z" vector-effect="non-scaling-stroke"></path>
    <circle r="20" vector-effect="non-scaling-stroke"></circle>
    <circle r="6" vector-effect="non-scaling-stroke"></circle>
  </g>
</svg>
