---
// Первый экран главной: без фото, винный фон, крупное название, слоган, две кнопки.
import LogoOrnament from './LogoOrnament.astro';
import { site } from '../../config/site';
import { pathFor, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const btn =
  'inline-flex min-h-12 items-center justify-center rounded-xl px-6 py-3 text-center font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral';
---

<section
  class="relative overflow-hidden bg-wine text-cream"
  aria-labelledby="hero-title"
>
  <!-- Мягкий гранатовый отсвет и тонкий ромб-орнамент (мотив логотипа), без фото -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_80%_10%,rgb(224_129_123/0.18),transparent_55%),radial-gradient(ellipse_at_10%_100%,rgb(63_158_118/0.10),transparent_50%)]"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-16 -bottom-16 size-72 rotate-45 rounded-3xl border border-blush/15 sm:size-96 md:hidden"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-4 -bottom-4 size-48 rotate-45 rounded-2xl border border-coral/20 sm:size-72 md:hidden"
  >
  </div>

  <!-- Крупный бледный орнамент из логотипа справа (только от 768 px, чтобы не мешать тексту на телефоне) -->
  <LogoOrnament
    class="pointer-events-none absolute top-1/2 hidden -translate-y-1/2 text-blush opacity-[0.07] md:block md:-right-24 md:size-[26rem] lg:right-[max(1rem,calc((100%-64rem)/2))] lg:size-[32rem] lg:opacity-[0.09]"
  />
  <div class="relative mx-auto max-w-5xl px-4 pt-10 pb-12 sm:pt-16 sm:pb-20">
    <p class="font-display text-sm tracking-[0.2em] text-coral uppercase">{t('hero.eyebrow')}</p>
    <h1
      id="hero-title"
      class="mt-3 font-display text-5xl font-light tracking-[0.18em] uppercase sm:text-7xl lg:text-8xl"
    >
      {site.name}
    </h1>
    <p class="mt-2 font-display text-sm tracking-[0.2em] text-rose-ash uppercase sm:text-base">{t('tagline')}</p>
    <p class="mt-6 max-w-2xl text-lg text-balance text-blush sm:text-xl">{t('hero.slogan')}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="#booking" class:list={[btn, 'bg-coral text-wine hover:bg-blush']}>{t('hero.book')}</a>
      <a href={pathFor(lang, 'menu')} class:list={[btn, 'border-2 border-blush/60 text-cream hover:border-cream']}>
        {t('nav.menu')}
      </a>
    </div>
  </div>
</section>
