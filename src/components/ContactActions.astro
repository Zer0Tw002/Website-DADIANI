---
// Кнопки связи: вопрос в WhatsApp + доставка (Яндекс Еда, Wolt).
// Кнопка доставки показывается, только когда ссылка в site.ts заполнена (не [TODO]).
import { isFilled, site, whatsappLink } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const delivery = [
  { url: site.delivery.yandexEda, label: t('delivery.yandex') },
  { url: site.delivery.wolt, label: t('delivery.wolt') },
].filter((d) => isFilled(d.url));

const btn =
  'inline-flex min-h-12 items-center justify-center rounded-xl px-5 py-3 text-center font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-2';
---

<div class="grid gap-6">
  <a
    href={whatsappLink(t('whatsapp.message'))}
    target="_blank"
    rel="noopener"
    class:list={[btn, 'bg-leaf-dark text-white hover:brightness-110 focus-visible:outline-leaf-dark sm:w-fit']}
  >
    {t('actions.question')}
  </a>

  {
    delivery.length > 0 && (
      <section aria-labelledby="delivery-title" class="grid gap-3">
        <h2 id="delivery-title" class="font-display text-sm tracking-[0.16em] text-rose-ash-dark uppercase">
          {t('delivery.title')}
        </h2>
        <p>{t('delivery.text')}</p>
        <div class="flex flex-wrap gap-3">
          {delivery.map((d) => (
            <a
              href={d.url}
              target="_blank"
              rel="noopener"
              class:list={[btn, 'border-2 border-wine text-wine hover:bg-wine hover:text-cream focus-visible:outline-wine']}
            >
              {d.label}
            </a>
          ))}
        </div>
      </section>
    )
  }
</div>
