---
// Круглая кнопка прокрутки (только экраны от 1024 px; включается в src/config/status.ts).
// Пока подвал не виден — стрелка вниз, ведёт к подвалу (адрес, график, контакты).
// Когда подвал на экране — стрелка вверх, ведёт к началу страницы.
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<button
  type="button"
  data-scroll-button
  data-label-down={t('scroll.down')}
  data-label-up={t('scroll.up')}
  aria-label={t('scroll.down')}
  title={t('scroll.down')}
  class="fixed right-6 bottom-6 z-30 hidden size-12 items-center justify-center rounded-full bg-pomegranate-dark text-cream shadow-lg shadow-wine/30 ring-1 ring-cream/30 transition hover:bg-wine motion-reduce:transition-none focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-coral lg:flex"
>
  <svg
    viewBox="0 0 24 24"
    width="22"
    height="22"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="transition-transform motion-reduce:transition-none"
    data-scroll-icon
  >
    <path d="M12 5v14M5 12l7 7 7-7"></path>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-scroll-button]');
  const icon = button?.querySelector<SVGElement>('[data-scroll-icon]');
  const footer = document.getElementById('contacts');

  if (button && footer) {
    let atFooter = false;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const render = () => {
      const label = atFooter ? button.dataset.labelUp! : button.dataset.labelDown!;
      button.setAttribute('aria-label', label);
      button.title = label;
      icon?.style.setProperty('transform', atFooter ? 'rotate(180deg)' : 'none');
    };

    // «У подвала» — когда верх подвала уже на экране
    const check = () => {
      const now = footer.getBoundingClientRect().top < window.innerHeight;
      if (now !== atFooter) {
        atFooter = now;
        render();
      }
    };
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        check();
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    check();

    button.addEventListener('click', () => {
      check(); // свежее состояние на момент нажатия
      const behavior: ScrollBehavior = reduceMotion.matches ? 'auto' : 'smooth';
      if (atFooter) window.scrollTo({ top: 0, behavior });
      else footer.scrollIntoView({ behavior, block: 'start' });
    });
  }
</script>
